[
  {
    "label": "Start",
    "command": "bash build && ./linus start -c config.yaml -e .env -p linus.pid && rm linus",
    "show_command": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
  },
  {
    "label": "Check config",
    "command": "go run ./cmd check -c config.yaml -e .env",
    "show_command": false,
  },
  {
    "label": "Build",
    "command": "bash build",
  },
]
